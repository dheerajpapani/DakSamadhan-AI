# DakSamadhan-AI Backend — Production Environment Variables

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service_role-key

# NLP / AI Configuration
# Required for automated classification and sentiment analysis
# Get a free "Inference API" token from: https://huggingface.co/settings/tokens
# HF_API_KEY=your_huggingface_token

# Server Configuration
PORT=8000
ENVIRONMENT=production

# Security (CORS)
# Add your Vercel URL here after deploying the frontend
# Example: https://daksamadhan.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
